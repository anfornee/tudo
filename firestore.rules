rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/weatherLocations/{locationId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/rides/{rideId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/routes/{routeId} {
      function validRoute() {
        return request.resource.data.keys().hasOnly([
            'userId', 'name', 'description', 'createdAt', 'updatedAt',
            'routeFilePath', 'distanceMeters', 'durationSeconds',
            'elevationGainMeters', 'elevationLossMeters', 'waypointCount',
            'provider', 'profile', 'startLatitude', 'startLongitude',
            'normalizedName', 'originalFilePath', 'originalFileName',
            'sourceFingerprint', 'segmentCount', 'revision', 'previewPath',
            'source', 'sourceLabel', 'sourceImportedAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId', 'name', 'description', 'createdAt', 'updatedAt',
            'routeFilePath', 'distanceMeters', 'durationSeconds',
            'elevationGainMeters', 'elevationLossMeters', 'waypointCount',
            'provider', 'profile', 'startLatitude', 'startLongitude',
            'normalizedName', 'originalFilePath', 'originalFileName',
            'sourceFingerprint', 'segmentCount', 'revision', 'previewPath',
            'source', 'sourceLabel', 'sourceImportedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName.size() > 0
          && request.resource.data.normalizedName.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.routeFilePath is string
          && request.resource.data.routeFilePath.matches('users/' + userId + '/routes/' + routeId + '/revisions/[^/]+[.]json')
          && (request.resource.data.originalFilePath == null
            || request.resource.data.originalFilePath.matches('users/' + userId + '/routes/' + routeId + '/originals/[^/]+[.](gpx|tcx)'))
          && (request.resource.data.originalFileName == null
            || (request.resource.data.originalFileName is string
              && request.resource.data.originalFileName.size() <= 255))
          && (request.resource.data.sourceFingerprint == null
            || (request.resource.data.sourceFingerprint is string
              && request.resource.data.sourceFingerprint.matches('[0-9a-f]{64}')))
          && request.resource.data.distanceMeters is number
          && request.resource.data.distanceMeters > 0
          && (request.resource.data.durationSeconds == null
            || (request.resource.data.durationSeconds is number
              && request.resource.data.durationSeconds >= 0))
          && (request.resource.data.elevationGainMeters == null
            || (request.resource.data.elevationGainMeters is number
              && request.resource.data.elevationGainMeters >= 0))
          && (request.resource.data.elevationLossMeters == null
            || (request.resource.data.elevationLossMeters is number
              && request.resource.data.elevationLossMeters >= 0))
          && request.resource.data.waypointCount is int
          && request.resource.data.waypointCount >= 2
          && request.resource.data.waypointCount <= 25
          && request.resource.data.segmentCount is int
          && request.resource.data.segmentCount >= 1
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.previewPath is string
          && request.resource.data.previewPath.size() <= 10000
          && request.resource.data.source in ['tudo', 'gpx', 'tcx', 'wahoo']
          && request.resource.data.sourceLabel is string
          && request.resource.data.sourceLabel.size() > 0
          && request.resource.data.sourceLabel.size() <= 120
          && (request.resource.data.sourceImportedAt == null
            || (request.resource.data.sourceImportedAt is string
              && request.resource.data.sourceImportedAt.size() <= 50))
          && request.resource.data.provider in ['openrouteservice', 'gpx', 'tcx', 'wahoo']
          && request.resource.data.profile in ['cycling-road', 'imported']
          && ((request.resource.data.provider == 'openrouteservice'
              && request.resource.data.profile == 'cycling-road')
            || (request.resource.data.provider != 'openrouteservice'
              && request.resource.data.profile == 'imported'))
          && request.resource.data.startLatitude is number
          && request.resource.data.startLatitude >= -90
          && request.resource.data.startLatitude <= 90
          && request.resource.data.startLongitude is number
          && request.resource.data.startLongitude >= -180
          && request.resource.data.startLongitude <= 180;
      }

      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validRoute()
        && request.resource.data.revision == 1;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validRoute()
        && request.resource.data.createdAt == resource.data.createdAt
        && ((!resource.data.keys().hasAny(['revision'])
              && request.resource.data.revision == 2)
            || (resource.data.keys().hasAny(['revision'])
              && request.resource.data.revision == resource.data.revision + 1));
    }

    match /users/{userId}/routeNames/{nameId} {
      function validRouteNameClaim() {
        return request.resource.data.keys().hasOnly(['routeId', 'normalizedName'])
          && request.resource.data.keys().hasAll(['routeId', 'normalizedName'])
          && request.resource.data.routeId is string
          && request.resource.data.routeId.size() > 0
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName.size() > 0
          && request.resource.data.normalizedName.size() <= 120;
      }

      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && validRouteNameClaim()
        && getAfter(/databases/$(database)/documents/users/$(userId)/routes/$(request.resource.data.routeId)).data.normalizedName
          == request.resource.data.normalizedName;
    }

    match /users/{userId}/riderProfiles/cycling {
      function validRiderProfile() {
        return request.resource.data.keys().hasOnly([
            'version', 'preferredUnits', 'heightCm', 'dateOfBirth',
            'physiologicalSex', 'restingHeartRateBpm', 'maxHeartRateBpm',
            'weightHistory', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'version', 'preferredUnits', 'heightCm', 'dateOfBirth',
            'physiologicalSex', 'restingHeartRateBpm', 'maxHeartRateBpm',
            'weightHistory', 'updatedAt'
          ])
          && request.resource.data.version is int
          && request.resource.data.version > 0
          && request.resource.data.preferredUnits in ['imperial', 'metric']
          && (request.resource.data.heightCm == null
            || (request.resource.data.heightCm is number
              && request.resource.data.heightCm >= 100
              && request.resource.data.heightCm <= 250))
          && (request.resource.data.dateOfBirth == null
            || request.resource.data.dateOfBirth is string)
          && (request.resource.data.physiologicalSex == null
            || request.resource.data.physiologicalSex in ['female', 'male'])
          && (request.resource.data.restingHeartRateBpm == null
            || (request.resource.data.restingHeartRateBpm is number
              && request.resource.data.restingHeartRateBpm >= 30
              && request.resource.data.restingHeartRateBpm <= 120))
          && (request.resource.data.maxHeartRateBpm == null
            || (request.resource.data.maxHeartRateBpm is number
              && request.resource.data.maxHeartRateBpm >= 100
              && request.resource.data.maxHeartRateBpm <= 240))
          && request.resource.data.weightHistory is list
          && request.resource.data.weightHistory.size() <= 100
          && request.resource.data.updatedAt is timestamp;
      }

      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && validRiderProfile()
        && request.resource.data.version == 1;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && validRiderProfile()
        && request.resource.data.version == resource.data.version + 1;
    }

    // OAuth credentials are written and read only by the server through Firebase Admin.
    match /users/{userId}/privateIntegrations/{integrationId} {
      allow read, write: if false;
    }

    match /users/{userId}/bills/{billId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'amount', 'dueDay', 'category', 'isAutopay',
          'isSubscription', 'notificationsEnabled', 'isActive',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.dueDay is int
        && request.resource.data.dueDay >= 1
        && request.resource.data.dueDay <= 31
        && request.resource.data.category in [
          'housing', 'utilities', 'transportation', 'insurance', 'debt',
          'entertainment', 'fitness', 'health', 'education', 'other'
        ]
        && request.resource.data.isAutopay is bool
        && request.resource.data.isSubscription is bool
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.isActive is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'title', 'completed', 'order', 'createdAt', 'completedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 500
        && request.resource.data.completed is bool
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.completedAt == null
          || request.resource.data.completedAt is timestamp)
        && (request.method != 'create'
          || (!request.resource.data.completed
            && request.resource.data.completedAt == null))
        && (request.method != 'update'
          || request.resource.data.createdAt == resource.data.createdAt);
    }

    match /users/{userId}/notificationTokens/{tokenId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'createdAt', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/preferences/notifications {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['timeZone', 'updatedAt'])
        && request.resource.data.timeZone is string
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/preferences/dashboard {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['featureOrder', 'updatedAt'])
        && request.resource.data.featureOrder is list
        && request.resource.data.featureOrder.size() <= 50
        && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/dev/firestore-test {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
